+       req->endpoint != endpoint || (data && req->buffer != data))
+      continue;
+    if(async_rx_active == i){
+      halt_channel(4);
+      wr(HCINTMSK(4), 0);
+      wr(HAINTMSK, rd(HAINTMSK) & ~(1U << 4));
+      wr(HCINT(4), 0x3fff);
+      dwc2_irq_pending &= ~(1U << 4);
+      async_rx_active = -1;
+    }
+    memset(req, 0, sizeof(*req));
+    req->state = RX_FREE;
+  }
+  dwc2_async_rx_start();
+  release(&usb_lock);
