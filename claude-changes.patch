+           channel, ver, rf,
+           ver == rf ? " (control-IN data looks stale)" :
+           (rf & MT_RF_CSR_KICK) ? " (RF KICK stuck)" : "");
+  } else if(fails == MT_SCAN_FAIL_LIMIT) {
+    printf("mt7601u: RF interface stuck after %d tries; "
+           "scan stays on channel %d\n", fails, dev->scan_channel);
+  }
