+// Wait n scheduler ticks (10 ms each) without holding any driver lock.  The
+// boot-time probe runs from do_initcalls() before the scheduler exists
+// (myproc() == 0) and can only spin; a process or kworker sleeps on the
+// timer tick instead, leaving the CPU to other work.
+static void
+brcmf_wait_ticks(int n)
+{
+  uint ticks0;
+  if(myproc() == 0){
+    brcmf_delay_us((uint32)n * 10000);
+    return;
+  }
+  acquire(&tickslock);
+  ticks0 = ticks;
+  while(ticks - ticks0 < (uint)n)
+    sleep(&ticks, &tickslock);
+  release(&tickslock);
+}
