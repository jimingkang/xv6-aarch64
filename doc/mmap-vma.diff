+  if(mem_minor(f) == ZERO_MINOR){
+    vma->vm_flags |= VM_NOFILEREF;   // becomes a plain anonymous mapping
+    return 0;
+  }
+  if(devmem_prot(vma->vm_pgoff << PGSHIFT, size, &prot) < 0)
+    return -1;
+  if(prot == PTE_DEVICE && (vma->vm_flags & VM_EXEC))
+    return -1;
