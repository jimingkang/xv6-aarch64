{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug xv6-arm64 (QEMU GDB)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/kernel/kernel",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "targetArchitecture": "arm64",
            "miDebuggerPath": "/opt/homebrew/bin/aarch64-elf-gdb",
            "miDebuggerArgs": "-nx",
            "miDebuggerServerAddress": "127.0.0.1:25501",
            "preLaunchTask": "xv6: start QEMU GDB server",
            "stopAtEntry": false,
            "stopAtConnect": false,
            "postRemoteConnectCommands": [
                {
                    "description": "远程连接完成后在内核 main 设置断点",
                    "text": "break main",
                    "ignoreFailures": false
                }
            ],
            "launchCompleteCommand": "exec-continue",
            "externalConsole": false,
            "logging": {
                "engineLogging": true,
                "trace": true,
                "traceResponse": true
            }
        }
    ]
}
