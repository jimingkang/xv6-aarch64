// <ctime> for xv6.  std::clock() has no per-process CPU account to read, so it
// returns the monotonic clock in microseconds (wall time of the process).
#pragma once
#include <__xv6_libc.h>
#include "../../include/time.h"
typedef long clock_t;
#define CLOCKS_PER_SEC 1000000L
namespace std {
using ::clock_t;
using ::time_t;
inline clock_t clock() { return (clock_t)::clock_us(); }
}
