_XV6_INTEGRAL(wchar_t) _XV6_INTEGRAL(char16_t) _XV6_INTEGRAL(char32_t)
_XV6_INTEGRAL(short) _XV6_INTEGRAL(unsigned short) _XV6_INTEGRAL(int) _XV6_INTEGRAL(unsigned int)
_XV6_INTEGRAL(long) _XV6_INTEGRAL(unsigned long) _XV6_INTEGRAL(long long) _XV6_INTEGRAL(unsigned long long)
#undef _XV6_INTEGRAL
template <class T> struct is_floating_point : false_type {};
template <> struct is_floating_point<float> : true_type {};
template <> struct is_floating_point<double> : true_type {};
template <> struct is_floating_point<long double> : true_type {};
}
template <class T> struct is_pointer : __detail::is_pointer<remove_cv_t<T>> {};
template <class T> struct is_integral : __detail::is_integral<remove_cv_t<T>> {};
template <class T> struct is_floating_point : __detail::is_floating_point<remove_cv_t<T>> {};
template <class T> struct is_arithmetic : bool_constant<is_integral<T>::value || is_floating_point<T>::value> {};
template <class T> struct is_signed : bool_constant<is_arithmetic<T>::value && (T(-1) < T(0))> {};
template <class T> struct is_unsigned : bool_constant<is_arithmetic<T>::value && !(T(-1) < T(0))> {};
template <class T> struct is_enum : bool_constant<__is_enum(T)> {};
template <class T> struct is_class : bool_constant<__is_class(T)> {};
template <class T> struct is_union : bool_constant<__is_union(T)> {};
template <class T> struct is_empty : bool_constant<__is_empty(T)> {};
template <class T> struct is_polymorphic : bool_constant<__is_polymorphic(T)> {};
template <class T> struct is_abstract : bool_constant<__is_abstract(T)> {};
template <class T> struct is_trivial : bool_constant<__is_trivial(T)> {};
template <class T> struct is_trivially_copyable : bool_constant<__is_trivially_copyable(T)> {};
template <class T> struct is_trivially_destructible : bool_constant<__has_trivial_destructor(T)> {};
template <class T> struct is_standard_layout : bool_constant<__is_standard_layout(T)> {};
template <class B, class D> struct is_base_of : bool_constant<__is_base_of(B, D)> {};
template <class T, class... A> struct is_constructible : bool_constant<__is_constructible(T, A...)> {};
template <class T> struct is_default_constructible : is_constructible<T> {};
template <class T> struct is_copy_constructible : is_constructible<T, const T &> {};
template <class T> struct is_move_constructible : is_constructible<T, T &&> {};
template <class T, class U> struct is_assignable : bool_constant<__is_assignable(T, U)> {};
template <class T, class... A> struct is_nothrow_constructible : bool_constant<__is_nothrow_constructible(T, A...)> {};
template <class T> struct is_nothrow_move_constructible : is_nothrow_constructible<T, T &&> {};
template <class T, class... A> struct is_trivially_constructible : bool_constant<__is_trivially_constructible(T, A...)> {};
template <class T> struct is_function : bool_constant<!is_const<const T>::value && !is_reference<T>::value> {};
template <class T> struct is_object : bool_constant<!is_function<T>::value && !is_reference<T>::value && !is_void<T>::value> {};
template <class T> struct is_scalar : bool_constant<is_arithmetic<T>::value || is_enum<T>::value || is_pointer<T>::value || is_same<nullptr_t, remove_cv_t<T>>::value> {};
template <class T> struct is_member_pointer : false_type {};
template <class T, class C> struct is_member_pointer<T C::*> : true_type {};

namespace __detail {
template <class T> void convert_to(T) noexcept;
template <class F, class T, class = void> struct is_convertible : false_type {};
template <class F, class T>
struct is_convertible<F, T, decltype(convert_to<T>(declval<F>()))> : true_type {};
}
template <class F, class T>
struct is_convertible : bool_constant<__detail::is_convertible<F, T>::value ||
                                      (is_void<F>::value && is_void<T>::value)> {};

template <class T> inline constexpr bool is_integral_v = is_integral<T>::value;
template <class T> inline constexpr bool is_floating_point_v = is_floating_point<T>::value;
template <class T> inline constexpr bool is_arithmetic_v = is_arithmetic<T>::value;
template <class T> inline constexpr bool is_pointer_v = is_pointer<T>::value;
template <class T> inline constexpr bool is_reference_v = is_reference<T>::value;
template <class T> inline constexpr bool is_trivially_copyable_v = is_trivially_copyable<T>::value;
template <class B, class D> inline constexpr bool is_base_of_v = is_base_of<B, D>::value;
template <class F, class T> inline constexpr bool is_convertible_v = is_convertible<F, T>::value;
template <class T, class... A> inline constexpr bool is_constructible_v = is_constructible<T, A...>::value;

template <class T> struct decay {
  typedef remove_reference_t<T> U;
  typedef conditional_t<is_array<U>::value, typename remove_extent<U>::type *,
          conditional_t<is_function<U>::value, add_pointer_t<U>, remove_cv_t<U>>> type;
};
template <class T> using decay_t = typename decay<T>::type;

template <class T> struct make_unsigned;
template <> struct make_unsigned<int> { typedef unsigned type; };
template <> struct make_unsigned<long> { typedef unsigned long type; };
template <> struct make_unsigned<long long> { typedef unsigned long long type; };
template <> struct make_unsigned<unsigned> { typedef unsigned type; };
template <> struct make_unsigned<unsigned long> { typedef unsigned long type; };
template <> struct make_unsigned<char> { typedef unsigned char type; };
template <class T> using make_unsigned_t = typename make_unsigned<T>::type;
template <class T> struct underlying_type { typedef __underlying_type(T) type; };

template <class...> using void_t = void;

template <class... T> struct common_type;
template <class T> struct common_type<T> { typedef decay_t<T> type; };
template <class T, class U> struct common_type<T, U> {
  typedef decay_t<decltype(true ? declval<T>() : declval<U>())> type;
};
template <class T, class U, class... R> struct common_type<T, U, R...> {
  typedef typename common_type<typename common_type<T, U>::type, R...>::type type;
};
template <class... T> using common_type_t = typename common_type<T...>::type;

template <class F, class... A> struct invoke_result { typedef decltype(declval<F>()(declval<A>()...)) type; };
template <class F, class... A> using invoke_result_t = typename invoke_result<F, A...>::type;
template <class F> struct result_of;
template <class F, class... A> struct result_of<F(A...)> : invoke_result<F, A...> {};

namespace __detail {
template <class, class F, class... A> struct is_invocable : false_type {};
template <class F, class... A>
struct is_invocable<void_t<decltype(declval<F>()(declval<A>()...))>, F, A...> : true_type {};
}
template <class F, class... A> struct is_invocable : __detail::is_invocable<void, F, A...> {};

constexpr bool is_constant_evaluated() noexcept { return __builtin_is_constant_evaluated(); }
}
