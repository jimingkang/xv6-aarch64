\@writefile{lof}{\contentsline {figure}{\numberline {6.12}{\ignorespaces 磁盘上的 inode 和它的块映射。\texttt  {\hyphenchar \font =-1 bmap(ip, bn)} 把文件内第 \texttt  {\hyphenchar \font =-1 bn} 块翻译成磁盘块号：小于 12 直接查 \texttt  {\hyphenchar \font =-1 addrs[bn]}，否则读间接块再查第 \texttt  {\hyphenchar \font =-1 bn-12} 项；遇到 0 就当场 \texttt  {\hyphenchar \font =-1 balloc()} 一块\relax }}{85}{figure.caption.49}\protected@file@percent }
\newlabel{fig:xv6-inode}{{6.12}{85}{磁盘上的 inode 和它的块映射。\code {bmap(ip, bn)} 把文件内第 \code {bn} 块翻译成磁盘块号：小于 12 直接查 \code {addrs[bn]}，否则读间接块再查第 \code {bn-12} 项；遇到 0 就当场 \code {balloc()} 一块\relax }{figure.caption.49}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.9.4}目录与路径查找}{85}{subsection.6.9.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6.13}{\ignorespaces \texttt  {\hyphenchar \font =-1 namei("/bin/ls")} 的查找过程。目录本身也是文件，内容是一串目录项；\texttt  {\hyphenchar \font =-1 namex()} 每次用 \texttt  {\hyphenchar \font =-1 skipelem()} 取出一个路径分量，在当前目录的内容里 \texttt  {\hyphenchar \font =-1 dirlookup()}，得到下一个 inode。块号 50、51 是 \texttt  {\hyphenchar \font =-1 mkfs} 的分配顺序决定的，k、m 取决于 \texttt  {\hyphenchar \font =-1 Makefile} 里程序的排列顺序\relax }}{86}{figure.caption.50}\protected@file@percent }
\newlabel{fig:xv6-namei}{{6.13}{86}{\code {namei("/bin/ls")} 的查找过程。目录本身也是文件，内容是一串目录项；\code {namex()} 每次用 \code {skipelem()} 取出一个路径分量，在当前目录的内容里 \code {dirlookup()}，得到下一个 inode。块号 50、51 是 \code {mkfs} 的分配顺序决定的，k、m 取决于 \code {Makefile} 里程序的排列顺序\relax }{figure.caption.50}{}}
