\@writefile{lof}{\contentsline {figure}{\numberline {7.4}{\ignorespaces USB 三种包的场布局。Token 包用 CRC5 保护“地址+端点”，Data 包用 CRC16 保护负载，Handshake 包只有 SYNC/PID/EOP、既无负载也无 CRC 场。关键区别：\textbf  {PID 场本身占 8 位（4 位本体再取反重发一次）}，双重编码已足以自校验，所以 PID 不需要额外 CRC，握手包也因此不必带 CRC\relax }}{88}{figure.caption.52}\protected@file@percent }
\newlabel{fig:usb-packet-format}{{7.4}{88}{USB 三种包的场布局。Token 包用 CRC5 保护“地址+端点”，Data 包用 CRC16 保护负载，Handshake 包只有 SYNC/PID/EOP、既无负载也无 CRC 场。关键区别：\textbf {PID 场本身占 8 位（4 位本体再取反重发一次）}，双重编码已足以自校验，所以 PID 不需要额外 CRC，握手包也因此不必带 CRC\relax }{figure.caption.52}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.5}{\ignorespaces 三相事务的三条主线（对应规范图 8-30 的 bulk 与图 8-36 的 control SETUP，只画成功分支）。蓝色箭头=主机发出，橙色箭头=设备发出。注意 Data 包的方向：SETUP 与 OUT 由主机写向设备，IN 由设备回给主机；Handshake 永远来自\emph  {本事务的接收方}。失败分支不在此图：设备无数据回 \texttt  {\hyphenchar \font =-1 NAK}、端点被停回 \texttt  {\hyphenchar \font =-1 STALL}（都结束本帧、由主机择机重发），高速 bulk OUT 在 OUT 令牌前还插一次 \texttt  {\hyphenchar \font =-1 PING} 探测缓冲\relax }}{89}{figure.caption.54}\protected@file@percent }
\newlabel{fig:usb-transaction-phases}{{7.5}{89}{三相事务的三条主线（对应规范图 8-30 的 bulk 与图 8-36 的 control SETUP，只画成功分支）。蓝色箭头=主机发出，橙色箭头=设备发出。注意 Data 包的方向：SETUP 与 OUT 由主机写向设备，IN 由设备回给主机；Handshake 永远来自\emph {本事务的接收方}。失败分支不在此图：设备无数据回 \code {NAK}、端点被停回 \code {STALL}（都结束本帧、由主机择机重发），高速 bulk OUT 在 OUT 令牌前还插一次 \code {PING} 探测缓冲\relax }{figure.caption.54}{}}
