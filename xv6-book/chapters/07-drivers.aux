\@writefile{lof}{\contentsline {figure}{\numberline {7.8}{\ignorespaces USB 键盘枚举与配置的决策流程。从上到下是五个阶段：控制器上电、识别 Hub 并供电、扫描端口与判速、描述符与接口匹配、注册绑定与武装 interrupt-IN。橙色框是判断， 灰色框是提前退出的分支，虚线表示递归与低速分支。整条链上只有地址、配置和接口三类判断 与“这是一只键盘”有关，其余部分对任何 USB 设备都一样\relax }}{94}{figure.caption.60}\protected@file@percent }
\newlabel{fig:usb-enum-flow}{{7.8}{94}{USB 键盘枚举与配置的决策流程。从上到下是五个阶段：控制器上电、识别 Hub 并供电、扫描端口与判速、描述符与接口匹配、注册绑定与武装 interrupt-IN。橙色框是判断， 灰色框是提前退出的分支，虚线表示递归与低速分支。整条链上只有地址、配置和接口三类判断 与“这是一只键盘”有关，其余部分对任何 USB 设备都一样\relax }{figure.caption.60}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.9}{\ignorespaces HID Boot 键盘报告（8 字节）。byte 0 是 8 个修饰键的位图，byte 2～7 是当前按着的最多 6 个键的 usage 编号\relax }}{95}{figure.caption.61}\protected@file@percent }
\newlabel{fig:hid-report}{{7.9}{95}{HID Boot 键盘报告（8 字节）。byte 0 是 8 个修饰键的位图，byte 2～7 是当前按着的最多 6 个键的 usage 编号\relax }{figure.caption.61}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.10}{\ignorespaces USB 键盘枚举与配置的软件函数调用链；同一行的浅灰等宽字是这一步实际打印的串口 日志，可与真机输出逐行对照。图中的描述符和配置请求都由 \texttt  {\hyphenchar \font =-1 control()} 经 ch0 同步完成；设备完成 \texttt  {\hyphenchar \font =-1 SET\_CONFIGURATION} 后才进入 USB 设备模型，类驱动的 \texttt  {\hyphenchar \font =-1 probe()} 注册 \texttt  {\hyphenchar \font =-1 event0}，最后由 \texttt  {\hyphenchar \font =-1 dwc2\_submit\_urb()} 把逻辑端点 EP1 映射到本机 host channel 6\relax }}{96}{figure.caption.62}\protected@file@percent }
\newlabel{fig:usb-hid-enum-call-chain}{{7.10}{96}{USB 键盘枚举与配置的软件函数调用链；同一行的浅灰等宽字是这一步实际打印的串口 日志，可与真机输出逐行对照。图中的描述符和配置请求都由 \code {control()} 经 ch0 同步完成；设备完成 \code {SET\_CONFIGURATION} 后才进入 USB 设备模型，类驱动的 \code {probe()} 注册 \code {event0}，最后由 \code {dwc2\_submit\_urb()} 把逻辑端点 EP1 映射到本机 host channel 6\relax }{figure.caption.62}{}}
