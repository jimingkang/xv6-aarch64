\newlabel{fig:usb-split}{{7.12}{105}{低速键盘在高速 Hub 后面的一次 interrupt-IN 轮询。主机先向 TT 发 start-split，TT 在低速总线上替主机完成 IN 事务，主机再在随后的微帧里发 complete-split 取回结果。\ding {172}、\ding {173} 两种中间事件必须在中断里当场处理，晚一个帧就错过了窗口\relax }{figure.caption.69}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7.7}{\ignorespaces 真机日志中的寄存器样本解码\relax }}{105}{table.caption.70}\protected@file@percent }
\newlabel{tab:usb-regs}{{7.7}{105}{真机日志中的寄存器样本解码\relax }{table.caption.70}{}}
\@writefile{toc}{\contentsline {paragraph}{HCSPLT：把一次事务拆成两拍的寄存器.}{105}{figure.caption.71}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7.13}{\ignorespaces \texttt  {\textsc  {HCSPLT}} 的位域。只要 \texttt  {\hyphenchar \font =-1 SPLTENA}$=1$，这次 channel 事务就不由 DWC2 自己驱动总线，而是交给 \texttt  {\hyphenchar \font =-1 HUBADDR}$+$\texttt  {\hyphenchar \font =-1 PORT} 指定的那颗 Hub 事务转换器（TT）代跑；两拍之间只有 \texttt  {\hyphenchar \font =-1 COMPSPLT} 一位不同（SSPLIT 为 0、CSPLIT 为 1），日志里 \texttt  {\hyphenchar \font =-1 0x8000c083} 与 \texttt  {\hyphenchar \font =-1 0x8001c083} 正是这一位之差。\texttt  {\hyphenchar \font =-1 XACTPOS} 本项目恒取 ALL（一次搬整包，不做首/尾微帧的分段）\relax }}{106}{figure.caption.71}\protected@file@percent }
\newlabel{fig:usb-hcsplt}{{7.13}{106}{\reg {HCSPLT} 的位域。只要 \code {SPLTENA}$=1$，这次 channel 事务就不由 DWC2 自己驱动总线，而是交给 \code {HUBADDR}$+$\code {PORT} 指定的那颗 Hub 事务转换器（TT）代跑；两拍之间只有 \code {COMPSPLT} 一位不同（SSPLIT 为 0、CSPLIT 为 1），日志里 \code {0x8000c083} 与 \code {0x8001c083} 正是这一位之差。\code {XACTPOS} 本项目恒取 ALL（一次搬整包，不做首/尾微帧的分段）\relax }{figure.caption.71}{}}
\@writefile{toc}{\contentsline {paragraph}{SSPLIT→CSPLIT 的状态机.}{106}{figure.caption.71}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{微帧窗口：CSPLIT 为什么必须在中断里发.}{106}{figure.caption.71}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{一次 split 只搬一个最大包，DATA 逐包翻转.}{106}{figure.caption.71}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{full-speed 也要 split，但不置 LSPDDEV.}{106}{figure.caption.71}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {7.4.7}URB 与中断驱动的接收}{107}{subsection.7.4.7}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{每设备状态，不是全局单例.}{107}{lstnumber.-125.9}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7.14}{\ignorespaces 一份键盘报告从硬件到 shell 的路径。每一列是一种执行上下文：硬中断只做与微帧时序有关的最少工作；HCD 的完成 work 负责缓存维护并把 URB 归还类驱动；HID 解析、输入事件和控制台都在键盘自己的 workqueue 里完成，最后重新提交 URB。键盘回 NAK（没有新按键）时，HCD completion 只登记 \texttt  {\hyphenchar \font =-1 bInterval} 期限，到期后由专用 DWC2 periodic workqueue 重发，URB 不归还类驱动\relax }}{108}{figure.caption.72}\protected@file@percent }
\newlabel{fig:usb-rx}{{7.14}{108}{一份键盘报告从硬件到 shell 的路径。每一列是一种执行上下文：硬中断只做与微帧时序有关的最少工作；HCD 的完成 work 负责缓存维护并把 URB 归还类驱动；HID 解析、输入事件和控制台都在键盘自己的 workqueue 里完成，最后重新提交 URB。键盘回 NAK（没有新按键）时，HCD completion 只登记 \code {bInterval} 期限，到期后由专用 DWC2 periodic workqueue 重发，URB 不归还类驱动\relax }{figure.caption.72}{}}
\@writefile{toc}{\contentsline {paragraph}{NAK 的无忙等周期重试.}{108}{figure.caption.73}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7.15}{\ignorespaces 运行期一次 interrupt-IN 轮询的完整时序。类驱动提交 URB 之后就不再参与： DWC2 与 Hub 的 TT 用 SSPLIT／CSPLIT 完成低速事务，有微帧截止时间的中间事件在硬中断里 当场推进。上半段是键盘没有新按键的情况，控制器只登记 \texttt  {\hyphenchar \font =-1 bInterval} 期限，到期后由 专用 periodic workqueue 重发，URB 不归还类驱动；下半段才是真正的一份报告，依次经过 DMA、IRQ、HCD completion、\texttt  {\hyphenchar \font =-1 usbkbd\_wq}，最后落到控制台与 \texttt  {\hyphenchar \font =-1 event0}\relax }}{109}{figure.caption.73}\protected@file@percent }
\newlabel{fig:usb-irq-seq}{{7.15}{109}{运行期一次 interrupt-IN 轮询的完整时序。类驱动提交 URB 之后就不再参与： DWC2 与 Hub 的 TT 用 SSPLIT／CSPLIT 完成低速事务，有微帧截止时间的中间事件在硬中断里 当场推进。上半段是键盘没有新按键的情况，控制器只登记 \code {bInterval} 期限，到期后由 专用 periodic workqueue 重发，URB 不归还类驱动；下半段才是真正的一份报告，依次经过 DMA、IRQ、HCD completion、\code {usbkbd\_wq}，最后落到控制台与 \code {event0}\relax }{figure.caption.73}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.16}{\ignorespaces 空闲键盘 NAK 后的调用链。\texttt  {\hyphenchar \font =-1 system\_wq} 与 \texttt  {\hyphenchar \font =-1 dwc2\_periodic\_wq}使用同一种 FIFO/kworker 执行机制；定时语义来自二者 之外的 \texttt  {\hyphenchar \font =-1 delayed\_head}。因此 \texttt  {\hyphenchar \font =-1 mod\_delayed\_work()}会立即返回， 不会把等待转移成另一个 kworker 上的忙等\relax }}{109}{figure.caption.74}\protected@file@percent }
\newlabel{fig:dwc2-periodic-wq}{{7.16}{109}{空闲键盘 NAK 后的调用链。\code {system\_wq} 与 \code {dwc2\_periodic\_wq}使用同一种 FIFO/kworker 执行机制；定时语义来自二者 之外的 \code {delayed\_head}。因此 \code {mod\_delayed\_work()}会立即返回， 不会把等待转移成另一个 kworker 上的忙等\relax }{figure.caption.74}{}}
