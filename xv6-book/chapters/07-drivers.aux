\@writefile{lof}{\contentsline {figure}{\numberline {7.7}{\ignorespaces DWC2 经外部 Hub 热插拔枚举低速 HID 键盘、直到收到第一个按键的总线时序。 ch7 只报告 Hub 的端口变化，worker 收到中断才 reprobe；EP0 枚举用 SSPLIT/CSPLIT 经 Hub 的 TT 转发；驱动绑定后 ch6 以 10\,ms 周期轮询按键，HID 报告最终由输入子 系统发布为事件\relax }}{93}{figure.caption.56}\protected@file@percent }
\newlabel{fig:usb-hid-enum-sequence}{{7.7}{93}{DWC2 经外部 Hub 热插拔枚举低速 HID 键盘、直到收到第一个按键的总线时序。 ch7 只报告 Hub 的端口变化，worker 收到中断才 reprobe；EP0 枚举用 SSPLIT/CSPLIT 经 Hub 的 TT 转发；驱动绑定后 ch6 以 10\,ms 周期轮询按键，HID 报告最终由输入子 系统发布为事件\relax }{figure.caption.56}{}}
\@writefile{toc}{\contentsline {paragraph}{枚举与配置的软件函数调用链.}{94}{figure.caption.56}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7.8}{\ignorespaces USB 键盘枚举与配置的软件函数调用链；同一行的浅灰等宽字是这一步实际打印的串口 日志，可与真机输出逐行对照。图中的描述符和配置请求都由 \texttt  {\hyphenchar \font =-1 control()} 经 ch0 同步完成；设备完成 \texttt  {\hyphenchar \font =-1 SET\_CONFIGURATION} 后才进入 USB 设备模型，类驱动的 \texttt  {\hyphenchar \font =-1 probe()} 注册 \texttt  {\hyphenchar \font =-1 event0}，最后由 \texttt  {\hyphenchar \font =-1 dwc2\_submit\_urb()} 把逻辑端点 EP1 映射到本机 host channel 6\relax }}{95}{figure.caption.57}\protected@file@percent }
\newlabel{fig:usb-hid-enum-call-chain}{{7.8}{95}{USB 键盘枚举与配置的软件函数调用链；同一行的浅灰等宽字是这一步实际打印的串口 日志，可与真机输出逐行对照。图中的描述符和配置请求都由 \code {control()} 经 ch0 同步完成；设备完成 \code {SET\_CONFIGURATION} 后才进入 USB 设备模型，类驱动的 \code {probe()} 注册 \code {event0}，最后由 \code {dwc2\_submit\_urb()} 把逻辑端点 EP1 映射到本机 host channel 6\relax }{figure.caption.57}{}}
