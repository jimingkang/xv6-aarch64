\@writefile{lof}{\contentsline {figure}{\numberline {7.13}{\ignorespaces 一份键盘报告从硬件到 shell 的路径。每一列是一种执行上下文：硬中断只做与微帧时序有关的最少工作；HCD 的完成 work 负责缓存维护并把 URB 归还类驱动；HID 解析、输入事件和控制台都在键盘自己的 workqueue 里完成，最后重新提交 URB。键盘回 NAK（没有新按键）时，HCD completion 只登记 \texttt  {\hyphenchar \font =-1 bInterval} 期限，到期后由专用 DWC2 periodic workqueue 重发，URB 不归还类驱动\relax }}{100}{figure.caption.66}\protected@file@percent }
\newlabel{fig:usb-rx}{{7.13}{100}{一份键盘报告从硬件到 shell 的路径。每一列是一种执行上下文：硬中断只做与微帧时序有关的最少工作；HCD 的完成 work 负责缓存维护并把 URB 归还类驱动；HID 解析、输入事件和控制台都在键盘自己的 workqueue 里完成，最后重新提交 URB。键盘回 NAK（没有新按键）时，HCD completion 只登记 \code {bInterval} 期限，到期后由专用 DWC2 periodic workqueue 重发，URB 不归还类驱动\relax }{figure.caption.66}{}}
\@writefile{toc}{\contentsline {paragraph}{NAK 的无忙等周期重试.}{100}{figure.caption.67}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {7.4.7}HID 报告与输入子系统}{100}{subsection.7.4.7}\protected@file@percent }
\newlabel{sec:usb-input}{{7.4.7}{100}{HID 报告与输入子系统}{subsection.7.4.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.14}{\ignorespaces 运行期一次 interrupt-IN 轮询的完整时序。类驱动提交 URB 之后就不再参与： DWC2 与 Hub 的 TT 用 SSPLIT／CSPLIT 完成低速事务，有微帧截止时间的中间事件在硬中断里 当场推进。上半段是键盘没有新按键的情况，控制器只登记 \texttt  {\hyphenchar \font =-1 bInterval} 期限，到期后由 专用 periodic workqueue 重发，URB 不归还类驱动；下半段才是真正的一份报告，依次经过 DMA、IRQ、HCD completion、\texttt  {\hyphenchar \font =-1 usbkbd\_wq}，最后落到控制台与 \texttt  {\hyphenchar \font =-1 event0}\relax }}{101}{figure.caption.67}\protected@file@percent }
\newlabel{fig:usb-irq-seq}{{7.14}{101}{运行期一次 interrupt-IN 轮询的完整时序。类驱动提交 URB 之后就不再参与： DWC2 与 Hub 的 TT 用 SSPLIT／CSPLIT 完成低速事务，有微帧截止时间的中间事件在硬中断里 当场推进。上半段是键盘没有新按键的情况，控制器只登记 \code {bInterval} 期限，到期后由 专用 periodic workqueue 重发，URB 不归还类驱动；下半段才是真正的一份报告，依次经过 DMA、IRQ、HCD completion、\code {usbkbd\_wq}，最后落到控制台与 \code {event0}\relax }{figure.caption.67}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.15}{\ignorespaces 空闲键盘 NAK 后的调用链。\texttt  {\hyphenchar \font =-1 system\_wq} 与 \texttt  {\hyphenchar \font =-1 dwc2\_periodic\_wq}使用同一种 FIFO/kworker 执行机制；定时语义来自二者 之外的 \texttt  {\hyphenchar \font =-1 delayed\_head}。因此 \texttt  {\hyphenchar \font =-1 mod\_delayed\_work()}会立即返回， 不会把等待转移成另一个 kworker 上的忙等\relax }}{101}{figure.caption.68}\protected@file@percent }
\newlabel{fig:dwc2-periodic-wq}{{7.15}{101}{空闲键盘 NAK 后的调用链。\code {system\_wq} 与 \code {dwc2\_periodic\_wq}使用同一种 FIFO/kworker 执行机制；定时语义来自二者 之外的 \code {delayed\_head}。因此 \code {mod\_delayed\_work()}会立即返回， 不会把等待转移成另一个 kworker 上的忙等\relax }{figure.caption.68}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.16}{\ignorespaces 一份 HID 报告进入输入子系统后的两条出路。上面两行是事件路径：类驱动解析报告、 转成 Linux 键码，由 input core 去重、成帧，再复制到每个 \texttt  {\hyphenchar \font =-1 open} 自己的 evdev 队列； 最后一行是字符路径：同一份报告查表转成字符后交给 \texttt  {\hyphenchar \font =-1 consoleintr()}，与 UART 收到的 字节共用同一套行规程。两条路径互不依赖，因此读 \texttt  {\hyphenchar \font =-1 /dev/input/eventN} 的程序和登录 会话可以同时存在，谁也不会把按键“读走”\relax }}{102}{figure.caption.69}\protected@file@percent }
\newlabel{fig:usb-input-flow}{{7.16}{102}{一份 HID 报告进入输入子系统后的两条出路。上面两行是事件路径：类驱动解析报告、 转成 Linux 键码，由 input core 去重、成帧，再复制到每个 \code {open} 自己的 evdev 队列； 最后一行是字符路径：同一份报告查表转成字符后交给 \code {consoleintr()}，与 UART 收到的 字节共用同一套行规程。两条路径互不依赖，因此读 \code {/dev/input/eventN} 的程序和登录 会话可以同时存在，谁也不会把按键“读走”\relax }{figure.caption.69}{}}
