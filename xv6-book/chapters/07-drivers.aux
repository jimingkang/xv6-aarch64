\@writefile{toc}{\contentsline {subsection}{\numberline {7.4.5}URB 与中断驱动的接收}{93}{subsection.7.4.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7.9}{\ignorespaces 一份键盘报告从硬件到 shell 的路径。每一列是一种执行上下文：硬中断只做与微帧时序有关的最少工作；HCD 的完成 work 负责缓存维护并把 URB 归还类驱动；HID 解析、输入事件和控制台都在键盘自己的 workqueue 里完成，最后重新提交 URB。键盘回 NAK（没有新按键）时，HCD completion 只登记 \texttt  {\hyphenchar \font =-1 bInterval} 期限，到期后由专用 DWC2 periodic workqueue 重发，URB 不归还类驱动\relax }}{94}{figure.caption.59}\protected@file@percent }
\newlabel{fig:usb-rx}{{7.9}{94}{一份键盘报告从硬件到 shell 的路径。每一列是一种执行上下文：硬中断只做与微帧时序有关的最少工作；HCD 的完成 work 负责缓存维护并把 URB 归还类驱动；HID 解析、输入事件和控制台都在键盘自己的 workqueue 里完成，最后重新提交 URB。键盘回 NAK（没有新按键）时，HCD completion 只登记 \code {bInterval} 期限，到期后由专用 DWC2 periodic workqueue 重发，URB 不归还类驱动\relax }{figure.caption.59}{}}
\@writefile{toc}{\contentsline {paragraph}{NAK 的无忙等周期重试.}{94}{figure.caption.59}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7.10}{\ignorespaces 空闲键盘 NAK 后的调用链。\texttt  {\hyphenchar \font =-1 system\_wq} 与 \texttt  {\hyphenchar \font =-1 dwc2\_periodic\_wq}使用同一种 FIFO/kworker 执行机制；定时语义来自二者 之外的 \texttt  {\hyphenchar \font =-1 delayed\_head}。因此 \texttt  {\hyphenchar \font =-1 mod\_delayed\_work()}会立即返回， 不会把等待转移成另一个 kworker 上的忙等\relax }}{95}{figure.caption.60}\protected@file@percent }
\newlabel{fig:dwc2-periodic-wq}{{7.10}{95}{空闲键盘 NAK 后的调用链。\code {system\_wq} 与 \code {dwc2\_periodic\_wq}使用同一种 FIFO/kworker 执行机制；定时语义来自二者 之外的 \code {delayed\_head}。因此 \code {mod\_delayed\_work()}会立即返回， 不会把等待转移成另一个 kworker 上的忙等\relax }{figure.caption.60}{}}
