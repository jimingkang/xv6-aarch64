\@writefile{lof}{\contentsline {figure}{\numberline {7.9}{\ignorespaces USB 键盘枚举与配置的决策流程。从上到下是五个阶段：控制器上电、识别 Hub 并供电、扫描端口与判速、描述符与接口匹配、注册绑定与武装 interrupt-IN。橙色框是判断， 灰色框是提前退出的分支，虚线表示递归与低速分支。整条链上只有地址、配置和接口三类判断 与“这是一只键盘”有关，其余部分对任何 USB 设备都一样\relax }}{103}{figure.caption.66}\protected@file@percent }
\newlabel{fig:usb-enum-flow}{{7.9}{103}{USB 键盘枚举与配置的决策流程。从上到下是五个阶段：控制器上电、识别 Hub 并供电、扫描端口与判速、描述符与接口匹配、注册绑定与武装 interrupt-IN。橙色框是判断， 灰色框是提前退出的分支，虚线表示递归与低速分支。整条链上只有地址、配置和接口三类判断 与“这是一只键盘”有关，其余部分对任何 USB 设备都一样\relax }{figure.caption.66}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7.11}{\ignorespaces USB 键盘枚举与配置的软件函数调用链；同一行的浅灰等宽字是这一步实际打印的串口 日志，可与真机输出逐行对照。图中的描述符和配置请求都由 \texttt  {\hyphenchar \font =-1 control()} 经 ch0 同步完成；设备完成 \texttt  {\hyphenchar \font =-1 SET\_CONFIGURATION} 后才进入 USB 设备模型，类驱动的 \texttt  {\hyphenchar \font =-1 probe()} 注册 \texttt  {\hyphenchar \font =-1 event0}，最后由 \texttt  {\hyphenchar \font =-1 dwc2\_submit\_urb()} 把逻辑端点 EP1 映射到本机 host channel 6\relax }}{104}{figure.caption.68}\protected@file@percent }
\newlabel{fig:usb-hid-enum-call-chain}{{7.11}{104}{USB 键盘枚举与配置的软件函数调用链；同一行的浅灰等宽字是这一步实际打印的串口 日志，可与真机输出逐行对照。图中的描述符和配置请求都由 \code {control()} 经 ch0 同步完成；设备完成 \code {SET\_CONFIGURATION} 后才进入 USB 设备模型，类驱动的 \code {probe()} 注册 \code {event0}，最后由 \code {dwc2\_submit\_urb()} 把逻辑端点 EP1 映射到本机 host channel 6\relax }{figure.caption.68}{}}
