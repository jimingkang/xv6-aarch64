\@writefile{lof}{\contentsline {figure}{\numberline {7.14}{\ignorespaces 软件 SCCB 发送 START 和地址字节 \texttt  {\hyphenchar \font =-1 0x6c}（$0110\,1100$）的波形，横轴是由 \texttt  {\hyphenchar \font =-1 bb\_delay()} 决定的时间。虚线是 SCL 高电平中点，从机在这里采样数据位；红色虚线是主机采样 ACK 的时刻；橙色区域里 SDA 由 OV5647 驱动——它在第 8 个时钟下降沿之后拉低 SDA，第 9 个时钟下降沿之后再释放\relax }}{108}{figure.caption.66}\protected@file@percent }
