\@writefile{lof}{\contentsline {figure}{\numberline {7.6}{\ignorespaces DWC2 经两级 Hub 枚举低速 HID 键盘并进入中断接收的时序。Root Hub 的 ch7 interrupt-IN只报告端口变化，worker 才按变化位读取端口状态；键盘 ch6 通过外部 Hub 的 TT 执行 SSPLIT/CSPLIT，最终由输入子系统发布事件\relax }}{90}{figure.caption.55}\protected@file@percent }
\newlabel{fig:usb-hid-enum-sequence}{{7.6}{90}{DWC2 经两级 Hub 枚举低速 HID 键盘并进入中断接收的时序。Root Hub 的 ch7 interrupt-IN只报告端口变化，worker 才按变化位读取端口状态；键盘 ch6 通过外部 Hub 的 TT 执行 SSPLIT/CSPLIT，最终由输入子系统发布事件\relax }{figure.caption.55}{}}
\@writefile{toc}{\contentsline {paragraph}{枚举与配置的软件函数调用链.}{91}{figure.caption.55}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7.7}{\ignorespaces USB 键盘枚举与配置的软件函数调用链。图\nobreakspace  {}\ref  {fig:usb-hid-enum-sequence} 中的描述符和配置请求都由 \texttt  {\hyphenchar \font =-1 control()} 经 ch0 同步完成；设备完成 \texttt  {\hyphenchar \font =-1 SET\_CONFIGURATION} 后才进入 USB 设备模型。类驱动的 \texttt  {\hyphenchar \font =-1 probe()} 注册 \texttt  {\hyphenchar \font =-1 event0} 并提交 interrupt URB，最后由 \texttt  {\hyphenchar \font =-1 dwc2\_submit\_urb()} 把逻辑端点 EP1 映射到本机 host channel 6\relax }}{92}{figure.caption.56}\protected@file@percent }
\newlabel{fig:usb-hid-enum-call-chain}{{7.7}{92}{USB 键盘枚举与配置的软件函数调用链。图~\ref {fig:usb-hid-enum-sequence} 中的描述符和配置请求都由 \code {control()} 经 ch0 同步完成；设备完成 \code {SET\_CONFIGURATION} 后才进入 USB 设备模型。类驱动的 \code {probe()} 注册 \code {event0} 并提交 interrupt URB，最后由 \code {dwc2\_submit\_urb()} 把逻辑端点 EP1 映射到本机 host channel 6\relax }{figure.caption.56}{}}
