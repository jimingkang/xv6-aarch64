\@writefile{lof}{\contentsline {figure}{\numberline {7.17}{\ignorespaces 一份 HID 报告进入输入子系统后的两条出路。上面两行是事件路径：类驱动解析报告、 转成 Linux 键码，由 input core 去重、成帧，再复制到每个 \texttt  {\hyphenchar \font =-1 open} 自己的 evdev 队列； 最后一行是字符路径：同一份报告查表转成字符后交给 \texttt  {\hyphenchar \font =-1 consoleintr()}，与 UART 收到的 字节共用同一套行规程。两条路径互不依赖，因此读 \texttt  {\hyphenchar \font =-1 /dev/input/eventN} 的程序和登录 会话可以同时存在，谁也不会把按键“读走”\relax }}{111}{figure.caption.75}\protected@file@percent }
\newlabel{fig:usb-input-flow}{{7.17}{111}{一份 HID 报告进入输入子系统后的两条出路。上面两行是事件路径：类驱动解析报告、 转成 Linux 键码，由 input core 去重、成帧，再复制到每个 \code {open} 自己的 evdev 队列； 最后一行是字符路径：同一份报告查表转成字符后交给 \code {consoleintr()}，与 UART 收到的 字节共用同一套行规程。两条路径互不依赖，因此读 \code {/dev/input/eventN} 的程序和登录 会话可以同时存在，谁也不会把按键“读走”\relax }{figure.caption.75}{}}
